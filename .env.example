# copy to .env.local for dev (.env.local is gitignored)

# local dev against docker-compose.dev.yml
DATABASE_URL=postgres://dave:dev@localhost:5432/moviereviews

# public origin — mandatory for adapter-node behind any reverse proxy
ORIGIN=http://localhost:5173

# admin auth — generate with `npm run hash-password -- yourpassword`
ADMIN_PASSWORD_HASH=

# 32 random bytes, base64 — generate with `openssl rand -base64 32`
AUTH_SECRET=

# tmdb — get at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# optional
LOG_LEVEL=info
