# copy to .env.local for dev (.env.local is gitignored)

# local dev against docker-compose.dev.yml (port 5433 to dodge conflicts on 5432)
DATABASE_URL=postgres://dave:dev@localhost:5433/moviereviews

# public origin — mandatory for adapter-node behind any reverse proxy
ORIGIN=http://localhost:5173

# admin auth — generate with `npm run hash-password -- yourpassword`
ADMIN_PASSWORD_HASH=

# 32 random bytes, base64 — generate with `openssl rand -base64 32`
AUTH_SECRET=

# tmdb — get at https://www.themoviedb.org/settings/api
TMDB_API_KEY=

# MCP connector (/mcp) — the password you type on the consent screen when
# Claude.ai connects. Unset means /authorize refuses to issue tokens at all.
MCP_AUTH_PASSWORD=

# optional
LOG_LEVEL=info

# open graph screenshotter — set OG_SCHEDULER=off in dev to disable the in-process cron
OG_CACHE_DIR=/app/og-cache
# OG_SCREENSHOT_URL=http://127.0.0.1:3000/
# per-review OG cards screenshot the app itself; prod defaults to 127.0.0.1:$PORT.
# In dev (vite on 5173) point it there to generate them locally:
# OG_SELF_ORIGIN=http://127.0.0.1:5173
# OG_SCHEDULER=off
# OG_TICK_MS=10800000       # override for testing (default 3h)
# OG_BOOT_DELAY_MS=60000    # override for testing (default 60s)
